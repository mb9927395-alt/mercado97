const $ = (selector) => document.querySelector(selector);
const $$ = (selector) => document.querySelectorAll(selector);


/* =========================================================
   INICIALIZAÇÃO
   ========================================================= */

document.addEventListener("DOMContentLoaded", () => {

    initializeM97();

});


function initializeM97() {

    applyTheme();
    applyLanguage();

    renderProducts(products);
    updateCartCounter();
    updateFavoriteCounter();

    setupSearch();
    setupCategoryButtons();
    setupLanguageButtons();
    setupThemeButton();
    setupMenu();

    animateElements();

}


/* =========================================================
   IDIOMAS
   ========================================================= */

function applyLanguage() {

    const lang = translations[M97.language];

    if (!lang) return;

    $$("[data-i18n]").forEach(element => {

        const key = element.dataset.i18n;

        if (lang[key]) {
            element.textContent = lang[key];
        }

    });

    $$("[data-i18n-placeholder]").forEach(element => {

        const key = element.dataset.i18nPlaceholder;

        if (lang[key]) {
            element.placeholder = lang[key];
        }

    });

    document.documentElement.lang = M97.language;

}


function changeLanguage(language) {

    if (!translations[language]) return;

    M97.language = language;

    localStorage.setItem("m97-language", language);

    applyLanguage();
    renderProducts(products);

    showNotification(
        language === "pt"
            ? "Idioma alterado"
            : language === "es"
                ? "Idioma cambiado"
                : "Language changed"
    );

}


/* =========================================================
   BOTÕES DE IDIOMA
   ========================================================= */

function setupLanguageButtons() {

    $$("[data-language]").forEach(button => {

        button.addEventListener("click", () => {

            changeLanguage(button.dataset.language);

            $$("[data-language]").forEach(btn => {
                btn.classList.remove("active");
            });

            button.classList.add("active");

        });

    });

}


/* =========================================================
   PRODUTOS
   ========================================================= */

function renderProducts(list) {

    const containers = [
        ".products-grid",
        "#products",
        ".product-grid",
        "[data-products]"
    ];

    let container = null;

    for (const selector of containers) {

        container = $(selector);

        if (container) break;

    }

    if (!container) return;

    container.innerHTML = "";

    if (!list.length) {

        container.innerHTML = `
            <div class="m97-no-results">
                <div class="m97-no-results-icon">🔎</div>
                <h3>Nenhum produto encontrado</h3>
                <p>Tente pesquisar outro produto.</p>
            </div>
        `;

        return;
    }


    list.forEach((product, index) => {

        const card = document.createElement("article");

        card.className = "product-card";

        card.dataset.id = product.id;

        card.style.animationDelay = `${index * 0.06}s`;

        const isFavorite = M97.favorites.includes(product.id);

        card.innerHTML = `

            <div class="product-image">

                <img
                    src="${product.image}"
                    alt="${product.names[M97.language]}"
                    loading="lazy"
                    onerror="this.style.display='none'"
                >

                <span class="discount">
                    -${product.discount}%
                </span>

                <button
                    class="favorite-btn ${isFavorite ? "active" : ""}"
                    data-favorite="${product.id}"
                    aria-label="Favorito"
                >
                    ${isFavorite ? "♥" : "♡"}
                </button>

            </div>

            <div class="product-info">

                <div class="product-rating">
                    ⭐ ${product.rating}
                </div>

                <h3>
                    ${product.names[M97.language]}
                </h3>

                <div class="price-area">

                    <strong>
                        ${formatPrice(product.price)}
                    </strong>

                    <del>
                        ${formatPrice(product.oldPrice)}
                    </del>

                </div>

                <div class="product-actions">

                    <button
                        class="add-cart"
                        data-cart="${product.id}"
                    >
                        🛒 ${translations[M97.language].add}
                    </button>

                    <button
                        class="buy-now"
                        data-buy="${product.id}"
                    >
                        ${translations[M97.language].buy}
                    </button>

                </div>

            </div>
        `;

        container.appendChild(card);

    });


    setupProductButtons();

}


/* =========================================================
