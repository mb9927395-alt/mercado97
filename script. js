function setupProductButtons() {

    $$("[data-cart]").forEach(button => {

        button.addEventListener("click", () => {

            const id = Number(button.dataset.cart);

            addToCart(id);

        });

    });


    $$("[data-buy]").forEach(button => {

        button.addEventListener("click", () => {

            const id = Number(button.dataset.buy);

            buyProduct(id);

        });

    });


    $$("[data-favorite]").forEach(button => {

        button.addEventListener("click", () => {

            const id = Number(button.dataset.favorite);

            toggleFavorite(id);

        });

    });

}


/* =========================================================
   CARRINHO
   ========================================================= */

function addToCart(id) {

    const product = products.find(item => item.id === id);

    if (!product) return;

    const existing = M97.cart.find(item => item.id === id);

    if (existing) {

        existing.quantity++;

    } else {

        M97.cart.push({
            id: id,
            quantity: 1
        });

    }

    saveCart();

    updateCartCounter();

    showNotification(
        M97.language === "pt"
            ? `${product.names.pt} adicionado ao carrinho`
            : M97.language === "es"
                ? `${product.names.es} agregado al carrito`
                : `${product.names.en} added to cart`
    );

}


function removeFromCart(id) {

    M97.cart = M97.cart.filter(item => item.id !== id);

    saveCart();

    updateCartCounter();

}


function changeQuantity(id, amount) {

    const item = M97.cart.find(product => product.id === id);

    if (!item) return;

    item.quantity += amount;

    if (item.quantity <= 0) {

        removeFromCart(id);

        return;

    }

    saveCart();

    updateCartCounter();

}


function saveCart() {

    localStorage.setItem(
        "m97-cart",
        JSON.stringify(M97.cart)
    );

}


function updateCartCounter() {

    const total = M97.cart.reduce(
        (sum, item) => sum + item.quantity,
        0
    );

    $$("[data-cart-count]").forEach(element => {

        element.textContent = total;

        element.style.display = total > 0 ? "flex" : "none";

    });

}


/* =========================================================
   FAVORITOS
   ========================================================= */

function toggleFavorite(id) {

    const index = M97.favorites.indexOf(id);

    if (index === -1) {

        M97.favorites.push(id);

        showNotification(
            M97.language === "pt"
                ? "Adicionado aos favoritos ❤️"
                : M97.language === "es"
                    ? "Agregado a favoritos ❤️"
                    : "Added to favorites ❤️"
        );

    } else {

        M97.favorites.splice(index, 1);

    }

    localStorage.setItem(
        "m97-favorites",
        JSON.stringify(M97.favorites)
    );

    updateFavoriteCounter();

    renderProducts(products);

}


function updateFavoriteCounter() {

    $$("[data-favorite-count]").forEach(element => {

        element.textContent = M97.favorites.length;

    });

}


/* =========================================================
   COMPRAR AGORA
   ========================================================= */

function buyProduct(id) {

    const product = products.find(item => item.id === id);

    if (!product) return;

    addToCart(id);

    setTimeout(() => {

        openCart();

    }, 250);

}


/* =========================================================
   PESQUISA
   ========================================================= */

function setupSearch() {

    const searchInputs = $$(
        'input[type="search"], [data-search], .search-input'
    );

    searchInputs.forEach(input => {

        input.addEventListener("input", () => {

            const query = input.value
                .trim()
                .toLowerCase();

            if (!query) {

                renderProducts(products);

                return;

            }

            const results = products.filter(product => {

                return Object.values(product.names)
                    .some(name =>
                        name.toLowerCase().includes(query)
                    );

            });

            renderProducts(results);

        });

    });

}


/* =========================================================
   CATEGORIAS
   ========================================================= */

function setupCategoryButtons() {

    $$("[data-category]").forEach(button => {

        button.addEventListener("click", () => {

            const category = button.dataset.category;

            $$("[data-category]").forEach(btn => {
                btn.classList.remove("active");
            });

            button.classList.add("active");

            if (
                category === "all" ||
                category === "todos"
            ) {

                renderProducts(products);

                return;

            }

            const filtered = products.filter(
                product => product.category === category
            );

            renderProducts(filtered);

        });

    });

}


/* =========================================================
   ABRIR CARRINHO
   ========================================================= */

function openCart() {

    const modal =
        $("#cart-modal") ||
        $(".cart-modal") ||
        $("[data-cart-modal]");

    if (modal) {

        modal.classList.add("active");
        document.body.classList.add("modal-open");

        renderCart();

        return;

    }

    renderCart();

}


/* =========================================================
   FECHAR CARRINHO
   ========================================================= */

function closeCart() {

    const modal =
        $("#cart-modal") ||
        $(".cart-modal") ||
        $("[data-cart-modal]");

    if (!modal) return;

    modal.classList.remove("active");

    document.body.classList.remove("modal-open");

}


/* =========================================================
   RENDERIZAR CARRINHO
   ========================================================= */

function renderCart() {

    const container =
        $("#cart-items") ||
        $(".cart-items") ||
        $("[data-cart-items]");

    if (!container) return;

    container.innerHTML = "";

    if (!M97.cart.length) {

        container.innerHTML = `
            <div class="empty-cart">
                <div class="empty-cart-icon">🛒</div>
                <h3>${translations[M97.language].emptyCart}</h3>
            </div>
        `;

        updateCartTotal();

        return;

    }


    M97.cart.forEach(item => {

        const product = products.find(
            product => product.id === item.id
        );

        if (!product) return;

        const element = document.createElement("div");

        element.className = "cart-item";

        element.innerHTML = `

            <img
                src="${product.image}"
                alt="${product.names[M97.language]}"
            >

            <div class="cart-item-info">

                <h4>
                    ${product.names[M97.language]}
                </h4>

                <strong>
                    ${formatPrice(product.price)}
                </strong>

                <div class="quantity">

                    <button
                        data-minus="${product.id}"
                    >
                        −
                    </button>

                    <span>
                        ${item.quantity}
                    </span>

                    <button
                        data-plus="${product.id}"
                    >
                        +
                    </button>

                </div>

            </div>

            <button
                class="remove-item"
                data-remove="${product.id}"
            >
                ×
            </button>
        `;

        container.appendChild(element);

    });


    $$("[data-minus]").forEach(button => {

        button.onclick = () => {

            changeQuantity(
                Number(button.dataset.minus),
                -1
            );

            renderCart();

        };

    });


    $$("[data-plus]").forEach(button => {

        button.onclick = () => {

            changeQuantity(
                Number(button.dataset.plus),
                1
            );

            renderCart();

        };

    });


    $$("[data-remove]").forEach(button => {

        button.onclick = () => {

            removeFromCart(
                Number(button.dataset.remove)
            );

            renderCart();

        };

    });


    updateCartTotal();

}


/* =========================================================
   TOTAL DO CARRINHO
   ========================================================= */

function updateCartTotal() {

    const total = M97.cart.reduce((sum, item) => {

        const product = products.find(
            product => product.id === item.id
        );

        if (!product) return sum;

        return sum + (
            product.price * item.quantity
        );

    }, 0);


    $$("[data-cart-total]").forEach(element => {

        element.textContent = formatPrice(total);

    });

}


/* =========================================================
   FORMATAÇÃO DE PREÇO
   ========================================================= */

function formatPrice(value) {

    if (M97.language === "pt") {

        return value.toLocaleString(
            "pt-BR",
            {
                style: "currency",
                currency: "BRL"
            }
        );

    }

    if (M97.language === "es") {

        return value.toLocaleString(
            "es-VE",
            {
                style: "currency",
                currency: "USD"
            }
        );

    }

    return value.toLocaleString(
        "en-US",
        {
            style: "currency",
            currency: "USD"
        }
    );

}


/* =========================================================
   MENU MOBILE
   ========================================================= */

function setupMenu() {

    const menuButton =
        $(".menu-button") ||
        $("#menu-button") ||
        $("[data-menu-button]");

    const menu =
        $(".mobile-menu") ||
        $("#mobile-menu") ||
        $("[data-mobile-menu]");

    if (!menuButton || !menu) return;

    menuButton.addEventListener("click", () => {

        menu.classList.toggle("active");

        document.body.classList.toggle(
            "menu-open"
        );

    });

}


/* =========================================================
   TEMA
   ========================================================= */

function setupThemeButton() {

    const buttons = $$(
        "[data-theme], #theme-toggle, .theme-toggle"
    );

    buttons.forEach(button => {

        button.addEventListener("click", toggleTheme);

    });

}


function toggleTheme() {

    M97.theme =
        M97.theme === "dark"
            ? "light"
            : "dark";

    localStorage.setItem(
        "m97-theme",
        M97.theme
    );

    applyTheme();

}


function applyTheme() {

    document.documentElement.dataset.theme =
        M97.theme;

    document.body.classList.toggle(
        "dark-mode",
        M97.theme === "dark"
    );

}


/* =========================================================
   NOTIFICAÇÕES
   ========================================================= */

function showNotification(message) {

    let notification =
        $(".m97-notification");

    if (!notification) {

        notification =
            document.createElement("div");

        notification.className =
            "m97-notification";

        document.body.appendChild(notification);

    }

    notification.textContent = message;

    notification.classList.add("show");

    clearTimeout(
        notification.hideTimer
    );

    notification.hideTimer =
        setTimeout(() => {

            notification.classList.remove("show");

        }, 2500);

}


/* =========================================================
   ANIMAÇÕES
   ========================================================= */

function animateElements() {

    const elements = $$(
        ".product-card, .hero, .category-card, .section-title"
    );

    if (!elements.length) return;

    const observer =
        new IntersectionObserver(
            entries => {

                entries.forEach(entry => {

                    if (
                        entry.isIntersecting
                    ) {

                        entry.target.classList.add(
                            "visible"
                        );

                        observer.unobserve(
                            entry.target
                        );

                    }

                });

            },
            {
                threshold: 0.1
            }
        );


    elements.forEach(element => {

        observer.observe(element);

    });

}


